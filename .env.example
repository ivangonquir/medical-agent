# Google AI Studio (free tier) - get key at https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Optional: OpenAI (for comparison)
OPENAI_API_KEY=your_openai_api_key_here

# PubMed / NCBI (optional, increases rate limit from 3 to 10 req/s)
NCBI_API_KEY=your_ncbi_api_key_here

# Default LLM to use: "gemini" | "cloudflare" | "openai"
DEFAULT_LLM=gemini
DEFAULT_MODEL=gemini-3.6-flash

# Embedding model for ChromaDB memory
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Data paths
PATIENT_MEMORY_DIR=./data/patient_memory
PDF_UPLOAD_DIR=./data/pdfs
